# Environment variables — Prospecta
# Copy to .env and fill locally. Never commit real secrets.

# PostgreSQL connection string
DATABASE_URL="postgresql://prospecta:prospecta@localhost:5433/prospecta"

# Public app URL (no trailing slash) — used in password-reset links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth — long random string (min 32 chars). Roles V1: ADMIN | MEMBER
AUTH_SECRET="replace-with-long-random-string-at-least-32-chars"

# Distributed rate limiting (required in Vercel Production; memory-only in local dev/test)
# Provision URL/token externally. Generate RATE_LIMIT_KEY_SECRET with a CSPRNG (at least 32 bytes).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_KEY_SECRET=""

# Transactional email (Fatia 2 — password reset)
# EMAIL_PROVIDER=console|resend (default: resend when RESEND_API_KEY is set, else console)
EMAIL_PROVIDER="console"
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Prospecta <onboarding@resend.dev>"

# Seed passwords (fictitious users only — never production secrets)
SEED_ADMIN_PASSWORD="replace-admin-seed-password"
SEED_MEMBER_PASSWORD="replace-member-seed-password"

# Machine-to-machine lead ingestion (Lead Intelligence / generator)
PROSPECTA_IMPORT_TOKEN="replace-with-long-random-import-token"
# Fallback owner when payload omits ownerEmail
LEAD_INGEST_DEFAULT_OWNER_EMAIL="comercial@prospecta.test"

# Vercel Cron (F4 weekly close) — Authorization: Bearer <CRON_SECRET>
# Generate a random string of at least 16 characters. Never commit the real value.
# CRON_SECRET="replace-with-long-random-cron-secret"

# Acquisition self-serve (ADMIN → external runner) — ADR 0014
# ACQUISITION_RUNNER_URL="http://127.0.0.1:8787"
# ACQUISITION_JOB_TOKEN="replace-with-long-random-acquisition-job-token"
# Completar carteira (F3) — defaults de piloto; override opcional
# ACQUISITION_FILL_CITY="Santos SP"
# ACQUISITION_FILL_QUERY="clínica odontológica"
# ACQUISITION_FILL_CAMPAIGN="santos-odontologia"

# Optional Playwright overrides (defaults match seed emails)
# E2E_ADMIN_EMAIL="admin@prospecta.test"
# E2E_ADMIN_PASSWORD=
# E2E_MEMBER_EMAIL="comercial@prospecta.test"
# E2E_MEMBER_PASSWORD=
