// Prospecta V1 — initial schema (no UI yet)
// Product decisions: docs/product/product-decision-mvp-technical.md
// ADR: docs/adr/0002-pipeline-lead-activity-v1.md, docs/adr/0003-auth-roles-v1.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum LeadStage {
  NEW
  QUALIFIED
  CONTACTED
  MEETING
  WON
  LOST
}

enum LeadSource {
  MANUAL
  GOOGLE_PLACES
  REFERRAL
  IMPORT
}

enum ActivityType {
  WHATSAPP
  EMAIL
  NOTE
  STAGE_CHANGE
}

enum ActivityOutcome {
  SENT_NO_REPLY
  REPLIED
  NOT_INTERESTED
  INTERESTED
  MEETING_SCHEDULED
  WRONG_CONTACT
  OTHER
}

enum AcquisitionJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum LeadAssignmentSource {
  ENROLL_OWNED
  MANUAL_ADMIN
  NEW_ACQUISITION
  RECYCLED
}

enum LeadAssignmentStatus {
  ACTIVE
  TREATED
  RELEASED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  passwordHash        String
  role                UserRole             @default(MEMBER)
  /// Explicit opt-in for Places acquisition pulls. ADMIN ignores this flag.
  /// Also gates weekly portfolio eligibility for MEMBER (carteira Fase 1).
  canRunAcquisition   Boolean              @default(false)
  isActive            Boolean              @default(true)
  mustChangePassword  Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  ownedLeads          Lead[]               @relation("LeadOwner")
  activities          Activity[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  acquisitionJobs     AcquisitionJob[]
  adminAuditEvents    AdminAuditEvent[]    @relation("AdminAuditActor")
  weeklyQuota         OperatorWeeklyQuota?
  quotasUpdated       OperatorWeeklyQuota[] @relation("QuotaUpdatedBy")
  weeklyPortfolios    WeeklyPortfolio[]
  leadAssignments     LeadAssignment[]     @relation("LeadAssignee")
  previousAssignments LeadAssignment[]     @relation("PreviousAssignee")
  assignmentsCreated  LeadAssignment[]     @relation("AssignmentAssignedBy")
}

/// Minimal durable trail for sensitive ADMIN mutations (not a full RBAC system).
model AdminAuditEvent {
  id           String   @id @default(cuid())
  action       String
  actorId      String
  actor        User     @relation("AdminAuditActor", fields: [actorId], references: [id])
  targetUserId String?
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Lead {
  id             String     @id @default(cuid())
  companyName    String
  contactName    String?
  title          String?
  email          String?
  phone          String?
  website        String?
  notes          String?
  source         LeadSource @default(MANUAL)
  externalId     String?
  intelligence   Json?
  stage          LeadStage  @default(NEW)
  nextFollowUpAt DateTime?
  lostReason     String?
  wonNote        String?
  ownerId        String
  owner           User             @relation("LeadOwner", fields: [ownerId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  activities      Activity[]
  assignments     LeadAssignment[]

  @@unique([source, externalId])
  @@index([stage])
  @@index([ownerId])
  @@index([nextFollowUpAt])
  @@index([email])
  @@index([phone])
  @@index([source])
}

model Activity {
  id                 String           @id @default(cuid())
  leadId             String
  lead               Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId           String
  author             User             @relation(fields: [authorId], references: [id])
  type               ActivityType
  outcome            ActivityOutcome?
  body               String?
  templateSnapshot   String?
  createdAt          DateTime         @default(now())
  treatedAssignments LeadAssignment[] @relation("TreatedByActivity")

  @@index([leadId, createdAt])
  @@index([authorId])
}

/// Per-operator weekly HIGH assignment meta (ADMIN-configurable).
model OperatorWeeklyQuota {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyTarget Int      @default(10)
  updatedById  String?
  updatedBy    User?    @relation("QuotaUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedById])
}

/// One open portfolio per operator per operational week (Mon–Sun SP → UTC).
model WeeklyPortfolio {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Monday 00:00 America/Sao_Paulo as UTC instant.
  weekStartAt    DateTime
  /// Sunday 23:59:59.999 America/Sao_Paulo as UTC instant.
  weekEndAt      DateTime
  targetSnapshot Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  assignments    LeadAssignment[]

  @@unique([userId, weekStartAt])
  @@index([weekStartAt])
}

/// Historical HIGH assignment. Lead.ownerId is the current owner pointer.
model LeadAssignment {
  id                 String               @id @default(cuid())
  leadId             String
  lead               Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assigneeId         String
  assignee           User                 @relation("LeadAssignee", fields: [assigneeId], references: [id])
  /// ADMIN (or system actor) who performed the assignment. Null only for pre-field rows.
  assignedById       String?
  assignedBy         User?                @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  portfolioId        String
  portfolio          WeeklyPortfolio      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  weekStartAt        DateTime
  source             LeadAssignmentSource
  status             LeadAssignmentStatus @default(ACTIVE)
  assignedAt         DateTime             @default(now())
  dueAt              DateTime
  treatedAt          DateTime?
  treatedActivityId  String?
  treatedActivity    Activity?            @relation("TreatedByActivity", fields: [treatedActivityId], references: [id])
  releasedAt         DateTime?
  releaseReason      String?
  previousAssigneeId String?
  previousAssignee   User?                @relation("PreviousAssignee", fields: [previousAssigneeId], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([assigneeId, weekStartAt, status])
  @@index([leadId, status])
  @@index([portfolioId])
  @@index([assignedById])
  // Partial unique (one ACTIVE per lead) lives in migration SQL —
  // LeadAssignment_active_lead_key — Prisma schema cannot express WHERE.
}

/// Places acquisition via external runner (ADR 0014).
/// Free Places pull (UI /admin/acquisition) is ADMIN only (weekly portfolio Fase 1).
/// MEMBER with canRunAcquisition remains portfolio-eligible; adaptive fill is Fase 3.
model AcquisitionJob {
  id              String               @id @default(cuid())
  status          AcquisitionJobStatus @default(QUEUED)
  city            String
  query           String
  limit           Int
  campaign        String
  fingerprint     String
  requestedById   String
  requestedBy     User                 @relation(fields: [requestedById], references: [id])
  requestedAt     DateTime             @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  timeoutAt       DateTime
  foundCount      Int?
  qualifiedCount  Int?
  createdTotal    Int?
  createdHigh     Int?
  existingCount   Int?
  failedCount     Int?
  errorMessage    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status])
  @@index([fingerprint, status])
  @@index([requestedAt])
  @@index([requestedById])
  // Partial unique index (QUEUED|RUNNING only) lives in migration SQL —
  // AcquisitionJob_active_fingerprint_key — Prisma schema cannot express WHERE.
}
